---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { translations, type Lang } from "../../i18n/index";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
    { params: { lang: "pt-BR" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang];

const allPosts = await getCollection("blog", (entry) => entry.slug.startsWith(`${lang}/`));
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout lang={lang} title={t.nav.blog}>
  <section class="pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold mb-8">{t.nav.blog}</h1>
      {allPosts.length === 0 && (
        <p class="text-gray-500">No posts yet.</p>
      )}
      <div class="space-y-8">
        {allPosts.map((post) => (
          <article class="border-b border-gray-200 pb-8">
            <time class="text-sm text-gray-500">{post.data.pubDate.toLocaleDateString(lang === "pt-BR" ? "pt" : lang)}</time>
            <h2 class="text-xl font-semibold mt-1 mb-2">
              <a href={`/${lang}/blog/${post.slug.replace(`${lang}/`, "")}`} class="hover:text-gray-600">
                {post.data.title}
              </a>
            </h2>
            <p class="text-gray-600 text-sm">{post.data.description}</p>
            <div class="flex gap-2 mt-3">
              {post.data.tags.map((tag) => (
                <span class="text-xs bg-gray-100 px-2 py-1 rounded">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
