---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { translations, type Lang } from "../../i18n/index";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
    { params: { lang: "pt-BR" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang];
---

<BaseLayout lang={lang} title={t.download.title}>
  <section class="pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl font-bold mb-4">{t.download.title}</h1>
      <p class="text-lg text-gray-600 mb-12">{t.download.subtitle}</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto mb-16">
        <a href="https://releases.syntrix.mx/latest/windows" class="flex flex-col items-center gap-3 p-6 border border-gray-200 rounded-xl hover:border-gray-400 transition-colors">
          <span class="text-3xl">&#x1F5A5;</span>
          <span class="font-medium">{t.download.forWindows}</span>
        </a>
        <a href="https://releases.syntrix.mx/latest/macos" class="flex flex-col items-center gap-3 p-6 border border-gray-200 rounded-xl hover:border-gray-400 transition-colors">
          <span class="text-3xl">&#x1F4BB;</span>
          <span class="font-medium">{t.download.forMac}</span>
        </a>
        <a href="https://releases.syntrix.mx/latest/linux" class="flex flex-col items-center gap-3 p-6 border border-gray-200 rounded-xl hover:border-gray-400 transition-colors">
          <span class="text-3xl">&#x1F427;</span>
          <span class="font-medium">{t.download.forLinux}</span>
        </a>
      </div>

      <div class="p-6 bg-gray-50 rounded-xl border border-gray-200 max-w-md mx-auto">
        <p class="text-sm text-gray-500">{t.download.comingSoon}</p>
      </div>
    </div>
  </section>
</BaseLayout>
