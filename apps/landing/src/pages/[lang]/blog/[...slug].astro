---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { type Lang } from "../../../i18n/index";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { lang: post.slug.split("/")[0], slug: post.slug.split("/").slice(1).join("/") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { lang } = Astro.params as { lang: Lang };
const { Content } = await post.render();
---

<BaseLayout lang={lang} title={post.data.title}>
  <section class="pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto">
      <time class="text-sm text-gray-500">{post.data.pubDate.toLocaleDateString(lang === "pt-BR" ? "pt" : lang)}</time>
      <h1 class="text-3xl font-bold mt-2 mb-4">{post.data.title}</h1>
      <p class="text-gray-600 mb-8">{post.data.description}</p>
      <article class="prose prose-gray max-w-none">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>
