#!/usr/bin/env bash

# Evitar loops recursivos
export IN_CARGO_BRIDGE=1

# Determinar rutas relativas de forma dinámica basadas en la ubicación del script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
REMOTE_REPO_ROOT="/root/remote-builds/syntrix-monorepo"

# Lock global para serializar el rsync de código fuente entre sesiones
LOCK_FILE="/tmp/syntrix-bridge-sync.lock"

# ID único por sesión (PID + timestamp + directorio) para targets independientes
SESSION_ID="$(echo "$(pwd)-$$-$(date +%s)" | md5sum 2>/dev/null | head -c 8 || echo "$$")"

# Buscar el cargo real en el PATH (evitando nuestra propia carpeta bin)
REAL_CARGO=""
IFS=':' read -r -a array <<< "$PATH"
for element in "${array[@]}"; do
    if [[ "$element" == *"/syntrix-monorepo/bin" ]]; then
        continue
    fi
    if [ -x "$element/cargo" ]; then
        REAL_CARGO="$element/cargo"
        break
    fi
done

if [ -z "$REAL_CARGO" ]; then
    REAL_CARGO="/run/current-system/sw/bin/cargo"
fi

# Si es una compilación o ejecución, la delegamos al servidor
if [[ "$1" == "build" || "$1" == "check" || "$1" == "clippy" || "$1" == "run" || "$1" == "doc" || "$1" == "test" || "$1" == "tauri" ]]; then
    # Servidor remoto por defecto (se puede sobreescribir con la variable de entorno REMOTE_HOST)
    REMOTE_HOST="${REMOTE_HOST:-server-1}"

    # Comprobación de disponibilidad y failover automático
    if [[ "$REMOTE_HOST" == "server-2" ]]; then
        # Si queremos usar server-2 pero está apagado/inaccesible, caemos en server-1
        # Usamos SSH en lugar de ping porque algunos servidores bloquean ICMP
        if ! ssh -o ConnectTimeout=3 -o BatchMode=yes "$REMOTE_HOST" "echo ok" >/dev/null 2>&1; then
            echo "=== [Bridge] server-2 está apagado o inaccesible (SSH falló). Redirigiendo compilación a server-1... ==="
            REMOTE_HOST="server-1"
        fi
    elif [[ "$REMOTE_HOST" == "server-1" ]]; then
        # Si queremos usar server-1 pero está apagado/inaccesible, intentamos caer en server-2
        if ! ssh -o ConnectTimeout=3 -o BatchMode=yes "$REMOTE_HOST" "echo ok" >/dev/null 2>&1; then
            echo "=== [Bridge] server-1 está apagado o inaccesible (SSH falló). Intentando fallback a server-2... ==="
            if ssh -o ConnectTimeout=3 -o BatchMode=yes server-2 "echo ok" >/dev/null 2>&1; then
                REMOTE_HOST="server-2"
            else
                echo "=== [Bridge] ¡ADVERTENCIA! Ambos servidores están inaccesibles. Usando server-1 por defecto. ==="
                REMOTE_HOST="server-1"
            fi
        fi
    fi

    # Calcular la ruta relativa de la carpeta actual
    CURRENT_DIR=$(pwd)
    if [[ "$CURRENT_DIR" == "$REPO_ROOT"* ]]; then
        RELATIVE_DIR=${CURRENT_DIR#"$REPO_ROOT"}
        RELATIVE_DIR=${RELATIVE_DIR#/}
    else
        RELATIVE_DIR=""
    fi
    REMOTE_DIR="$REMOTE_REPO_ROOT/$RELATIVE_DIR"

    echo "=== [Bridge:${SESSION_ID}] Sincronizando código a $REMOTE_HOST (ThinkCentre)... ==="
    # Asegurar que el directorio remoto existe en el servidor elegido
    ssh "$REMOTE_HOST" "mkdir -p $REMOTE_REPO_ROOT"
    
    # Lock global para evitar que dos sesiones rsync code al mismo tiempo
    # (flock libera el lock automáticamente al terminar el subshell)
    (
      flock -x 200 || exit 1
      
      # Sincronizar código fuente de la laptop al servidor elegido
      rsync -avz --delete \
        --exclude 'target' \
        --exclude 'target-*' \
        --exclude 'node_modules' \
        --exclude '.git' \
        --exclude '.direnv' \
        --exclude '.devenv' \
        "$REPO_ROOT/" \
        "$REMOTE_HOST:$REMOTE_REPO_ROOT/"
    ) 200>"$LOCK_FILE"
    RSYNC_EXIT=$?
    if [ $RSYNC_EXIT -ne 0 ]; then
        echo "=== [Bridge:${SESSION_ID}] ERROR: No se pudo adquirir el lock de sincronización (otra sesión está compilando). Reintenta en unos segundos. ==="
        exit 1
    fi

    # Reemplazar rutas absolutas de la laptop a las del servidor en los argumentos
    # Y si es "run" o "tauri dev", transformarlos a "build" para solo compilar en el servidor
    REMOTE_ARGS=()
    IS_TAURI_DEV=0
    if [[ "$1" == "run" ]]; then
        REMOTE_ARGS+=("build")
        for arg in "${@:2}"; do
            if [[ "$arg" == "--" ]]; then
                break
            fi
            # Reemplazar ruta local por ruta remota
            REMOTE_ARGS+=("${arg//$REPO_ROOT/$REMOTE_REPO_ROOT}")
        done
    elif [[ "$1" == "tauri" && "$2" == "dev" ]]; then
        # "tauri dev" en el servidor: solo compilar (build), sin beforeDevCommand ni ejecución
        IS_TAURI_DEV=1
        REMOTE_ARGS+=("build")
    else
        for arg in "$@"; do
            # Reemplazar ruta local por ruta remota
            REMOTE_ARGS+=("${arg//$REPO_ROOT/$REMOTE_REPO_ROOT}")
        done
    fi

    echo "=== [Bridge:${SESSION_ID}] Escribiendo script de compilación remoto en $REMOTE_HOST... ==="
    # Escribimos el script de compilación en el servidor sin problemas de escape usando un heredoc con comillas simples ('EOF')
    ssh "$REMOTE_HOST" "cat > /tmp/remote_cargo_build.sh" << 'EOF'
#!/usr/bin/env bash
REMOTE_DIR="$1"
SESSION_ID="$2"
shift 2

DEPS="nixpkgs#glib.dev nixpkgs#gtk3.dev nixpkgs#webkitgtk_4_1.dev nixpkgs#libsoup_3.dev nixpkgs#openssl.dev nixpkgs#cairo.dev nixpkgs#pango.dev nixpkgs#gdk-pixbuf.dev nixpkgs#at-spi2-core.dev nixpkgs#harfbuzz.dev nixpkgs#freetype.dev nixpkgs#fontconfig.dev nixpkgs#libxkbcommon.dev nixpkgs#libepoxy.dev nixpkgs#graphene.dev nixpkgs#libdrm.dev nixpkgs#zlib.dev nixpkgs#libpng.dev nixpkgs#libjpeg.dev nixpkgs#pkg-config nixpkgs#cargo nixpkgs#rustc nixpkgs#cmake nixpkgs#perl nixpkgs#nodejs_22 nixpkgs#mold nixpkgs#clang"

PKG_SETUP='export PKG_CONFIG_PATH=""; for d in /nix/store/*/lib/pkgconfig /nix/store/*/share/pkgconfig; do [ -d "$d" ] && ls "$d"/*.pc >/dev/null 2>&1 && PKG_CONFIG_PATH="$PKG_CONFIG_PATH:$d"; done; export PKG_CONFIG_PATH'

cd "$REMOTE_DIR" || exit 1

# Cada sesión compila en su propio target-$SESSION_ID para no competir por el lock de Cargo
nix --extra-experimental-features 'nix-command flakes' shell $DEPS --command bash -c "$PKG_SETUP && CARGO_TARGET_DIR=\"target-\$SESSION_ID\" cargo $*"
EOF

    echo "=== [Bridge:${SESSION_ID}] Compilando remotamente en $REMOTE_HOST... ==="
    ssh "$REMOTE_HOST" "SESSION_ID=$SESSION_ID bash /tmp/remote_cargo_build.sh '$REMOTE_DIR' '$SESSION_ID' ${REMOTE_ARGS[@]}"
    EXIT_CODE=$?

    if [ $EXIT_CODE -eq 0 ]; then
        REMOTE_TARGET_DIR="$REMOTE_DIR/target-$SESSION_ID"
        echo "=== [Bridge:${SESSION_ID}] Descargando binario y target compilado de regreso... ==="
        
        # Determinar el directorio target local (workspace o app-level según CURRENT_DIR)
        LOCAL_TARGET="$CURRENT_DIR/target"
        
        # Traer de regreso el binario y metadatos (sin la caché incremental que es específica del servidor)
        rsync -avz \
          --exclude 'incremental' \
          --exclude '.fingerprint' \
          --exclude 'build' \
          --exclude 'deps' \
          "$REMOTE_HOST:$REMOTE_TARGET_DIR/" "$LOCAL_TARGET/"
        
        # Limpiar el target de esta sesión en el remoto para no acumular
        ssh "$REMOTE_HOST" "rm -rf $REMOTE_TARGET_DIR" 2>/dev/null || true
        
        # Si era un "run", ahora ejecutamos el binario local directamente
        if [[ "$1" == "run" ]]; then
            BINARY_NAME=""
            if [[ -f "Cargo.toml" ]]; then
                BINARY_NAME=$(grep -m1 '^name = ' Cargo.toml | cut -d'"' -f2)
            fi
            BINARY_NAME="${BINARY_NAME:-syntrix-admin}"
            BINARY_PATH="./target/debug/$BINARY_NAME"
            
            # Obtener los argumentos después del "--"
            BIN_ARGS=()
            FOUND_SEPARATOR=false
            for arg in "$@"; do
                if [[ "$FOUND_SEPARATOR" == true ]]; then
                    BIN_ARGS+=("$arg")
                elif [[ "$arg" == "--" ]]; then
                    FOUND_SEPARATOR=true
                fi
            done
            
            if [[ -f "$BINARY_PATH" ]]; then
                echo "=== [Bridge:${SESSION_ID}] Iniciando ejecución local directa: $BINARY_PATH ${BIN_ARGS[@]} ==="
                chmod +x "$BINARY_PATH"
                exec "$BINARY_PATH" "${BIN_ARGS[@]}"
            else
                echo "=== [Bridge:${SESSION_ID}] ADVERTENCIA: No se encontró el binario en $BINARY_PATH. Usando cargo local... ==="
                exec "$REAL_CARGO" "$@"
            fi
        fi

        # Si era "tauri dev", compilamos en el servidor y ejecutamos localmente
        if [[ "$IS_TAURI_DEV" == "1" ]]; then
            BINARY_NAME=""
            if [[ -f "Cargo.toml" ]]; then
                BINARY_NAME=$(grep -m1 '^name = ' Cargo.toml | cut -d'"' -f2)
            fi
            BINARY_NAME="${BINARY_NAME:-syntrix-admin}"
            BINARY_PATH="./target/debug/$BINARY_NAME"

            if [[ ! -f "$BINARY_PATH" ]]; then
                echo "=== [Bridge:${SESSION_ID}] ADVERTENCIA: No se encontró el binario en $BINARY_PATH. Usando cargo local... ==="
                exec "$REAL_CARGO" "$@"
            fi

            chmod +x "$BINARY_PATH"

            # Calcular el directorio de la app (un nivel arriba de src-tauri)
            APP_DIR="$(dirname "$CURRENT_DIR")"

            echo "=== [Bridge:${SESSION_ID}] Iniciando beforeDevCommand (pnpm dev) en $APP_DIR... ==="
            # Matar instancias previas de vite
            pkill -f "vite" 2>/dev/null || true
            # Iniciar pnpm dev en background (subshell para no afectar el directorio actual)
            (cd "$APP_DIR" && pnpm dev) &
            VITE_PID=$!
            # Asegurar limpieza al salir (Ctrl+C, etc.)
            cleanup_vite() { kill "$VITE_PID" 2>/dev/null || true; pkill -f "$APP_DIR.*vite" 2>/dev/null || true; }
            trap cleanup_vite EXIT INT TERM

            # Esperar a que Vite esté listo (buscar "ready" o "Local:" en la salida)
            echo "=== [Bridge:${SESSION_ID}] Esperando a que Vite esté listo... ==="
            for i in $(seq 1 30); do
                if curl -s http://localhost:1421 >/dev/null 2>&1 || curl -s http://localhost:1420 >/dev/null 2>&1; then
                    echo "=== [Bridge:${SESSION_ID}] Vite está listo ==="
                    break
                fi
                sleep 1
            done

            echo "=== [Bridge:${SESSION_ID}] Iniciando $BINARY_PATH localmente... ==="
            cd "$CURRENT_DIR"
            "$BINARY_PATH"
            BINARY_EXIT=$?
            # Al salir el binario, matar pnpm dev
            kill "$VITE_PID" 2>/dev/null || true
            pkill -f "$APP_DIR.*vite" 2>/dev/null || true
            exit $BINARY_EXIT
        fi
    fi
    exit $EXIT_CODE
else
    # Ejecutar localmente cualquier otro comando
    exec "$REAL_CARGO" "$@"
fi
