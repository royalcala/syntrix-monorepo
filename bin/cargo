#!/usr/bin/env bash

# Evitar loops recursivos
export IN_CARGO_BRIDGE=1

# Determinar rutas relativas de forma dinámica basadas en la ubicación del script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
REMOTE_REPO_ROOT="/root/remote-builds/syntrix-monorepo"

# ID único por sesión solo para logging (ya no se usa para el target dir)
SESSION_ID="$(echo "$(pwd)-$$-$(date +%s)" | md5sum 2>/dev/null | head -c 8 || echo "$$")"

# Target dir persistente en el remoto (se reutiliza entre invocaciones → caché de compilación)
REMOTE_TARGET_NAME="target-remote"

# Buscar el cargo real en el PATH (evitando nuestra propia carpeta bin)
REAL_CARGO=""
IFS=':' read -r -a array <<< "$PATH"
for element in "${array[@]}"; do
    if [[ "$element" == *"/syntrix-monorepo/bin" ]]; then
        continue
    fi
    if [ -x "$element/cargo" ]; then
        REAL_CARGO="$element/cargo"
        break
    fi
done

if [ -z "$REAL_CARGO" ]; then
    REAL_CARGO="/run/current-system/sw/bin/cargo"
fi

# Si es una compilación o ejecución, la delegamos al servidor
if [[ "$1" == "build" || "$1" == "check" || "$1" == "clippy" || "$1" == "run" || "$1" == "doc" || "$1" == "test" || "$1" == "tauri" ]]; then
    # Servidor remoto por defecto (se puede sobreescribir con la variable de entorno REMOTE_HOST)
    REMOTE_HOST="${REMOTE_HOST:-server-1}"

    # Comprobación de disponibilidad y failover automático
    if [[ "$REMOTE_HOST" == "server-2" ]]; then
        if ! ssh -o ConnectTimeout=3 -o BatchMode=yes "$REMOTE_HOST" "echo ok" >/dev/null 2>&1; then
            echo "=== [Bridge] server-2 está apagado o inaccesible (SSH falló). Redirigiendo compilación a server-1... ==="
            REMOTE_HOST="server-1"
        fi
    elif [[ "$REMOTE_HOST" == "server-1" ]]; then
        if ! ssh -o ConnectTimeout=3 -o BatchMode=yes "$REMOTE_HOST" "echo ok" >/dev/null 2>&1; then
            echo "=== [Bridge] server-1 está apagado o inaccesible (SSH falló). Intentando fallback a server-2... ==="
            if ssh -o ConnectTimeout=3 -o BatchMode=yes server-2 "echo ok" >/dev/null 2>&1; then
                REMOTE_HOST="server-2"
            else
                echo "=== [Bridge] ¡ADVERTENCIA! Ambos servidores están inaccesibles. Usando server-1 por defecto. ==="
                REMOTE_HOST="server-1"
            fi
        fi
    fi

    # Lock por host: serializa sync + compilación en el MISMO servidor remoto
    # Sesiones a diferentes servidores (server-1 vs server-2) NO compiten
    LOCK_FILE="/tmp/syntrix-bridge-sync-${REMOTE_HOST}.lock"

    # Calcular la ruta relativa de la carpeta actual
    CURRENT_DIR=$(pwd)
    if [[ "$CURRENT_DIR" == "$REPO_ROOT"* ]]; then
        RELATIVE_DIR=${CURRENT_DIR#"$REPO_ROOT"}
        RELATIVE_DIR=${RELATIVE_DIR#/}
    else
        RELATIVE_DIR=""
    fi
    REMOTE_DIR="$REMOTE_REPO_ROOT/$RELATIVE_DIR"
    REMOTE_TARGET_DIR="$REMOTE_DIR/$REMOTE_TARGET_NAME"

    # Determinar el modo de operación ANTES del lock (las variables de subshell no se propagan)
    IS_TAURI_DEV=0
    if [[ "$1" == "tauri" && "$2" == "dev" ]]; then
        IS_TAURI_DEV=1
    fi

    # =========================================================================
    # BLOQUE CON LOCK: solo sync + compilación remota + rsync de regreso
    # El lock se libera automáticamente al salir de este subshell
    # =========================================================================
    (
      flock -x 200 || exit 1

      echo "=== [Bridge:${SESSION_ID}] Sincronizando código a $REMOTE_HOST (ThinkCentre)... ==="
      ssh "$REMOTE_HOST" "mkdir -p $REMOTE_REPO_ROOT"

      rsync -avz --delete \
        --exclude 'target' \
        --exclude 'target-*' \
        --exclude 'node_modules' \
        --exclude '.git' \
        --exclude '.direnv' \
        --exclude '.devenv' \
        "$REPO_ROOT/" \
        "$REMOTE_HOST:$REMOTE_REPO_ROOT/"

      if [ $? -ne 0 ]; then
          echo "=== [Bridge:${SESSION_ID}] ERROR: rsync falló. ==="
          exit 1
      fi

      # Reemplazar rutas absolutas de la laptop a las del servidor en los argumentos
      # Y si es "run" o "tauri dev", transformarlos a "build" para solo compilar en el servidor
      REMOTE_ARGS=()
      if [[ "$1" == "run" ]]; then
          REMOTE_ARGS+=("build")
          for arg in "${@:2}"; do
              if [[ "$arg" == "--" ]]; then
                  break
              fi
              REMOTE_ARGS+=("${arg//$REPO_ROOT/$REMOTE_REPO_ROOT}")
          done
      elif [[ "$IS_TAURI_DEV" == "1" ]]; then
          REMOTE_ARGS+=("build")
      else
          for arg in "$@"; do
              REMOTE_ARGS+=("${arg//$REPO_ROOT/$REMOTE_REPO_ROOT}")
          done
      fi

      echo "=== [Bridge:${SESSION_ID}] Compilando remotamente en $REMOTE_HOST (target persistente: $REMOTE_TARGET_NAME)... ==="
      # Escribimos el script de compilación en el servidor
      ssh "$REMOTE_HOST" "cat > /tmp/remote_cargo_build.sh" << 'SCRIPTEOF'
#!/usr/bin/env bash
REMOTE_DIR="$1"
REMOTE_TARGET_NAME="$2"
shift 2

DEPS_BASE="nixpkgs#glib.dev nixpkgs#gtk3.dev nixpkgs#webkitgtk_4_1.dev nixpkgs#libsoup_3.dev nixpkgs#openssl.dev nixpkgs#cairo.dev nixpkgs#pango.dev nixpkgs#gdk-pixbuf.dev nixpkgs#at-spi2-core.dev nixpkgs#harfbuzz.dev nixpkgs#freetype.dev nixpkgs#fontconfig.dev nixpkgs#libxkbcommon.dev nixpkgs#libepoxy.dev nixpkgs#graphene.dev nixpkgs#libdrm.dev nixpkgs#zlib.dev nixpkgs#libpng.dev nixpkgs#libjpeg.dev nixpkgs#pkg-config nixpkgs#cmake nixpkgs#perl nixpkgs#nodejs_22 nixpkgs#mold nixpkgs#clang nixpkgs#glibc.dev"
# Use system cargo/rustc (from NixOS systemPackages or rustup) when available.
# nixpkgs#rustc 1.95.0+llvm21 has a SIGSEGV bug on some Intel CPUs (server-1 i5-8500).
if command -v cargo >/dev/null 2>&1 && command -v rustc >/dev/null 2>&1; then
    DEPS="$DEPS_BASE"
    # Use system cargo but limit to 1 job — LLVM crashes with parallel ThinLTO on some CPUs
    CARGO_CMD="CARGO_BUILD_JOBS=1 RUST_MIN_STACK=33554432 cargo"
else
    DEPS="$DEPS_BASE nixpkgs#cargo nixpkgs#rustc"
    CARGO_CMD="RUST_MIN_STACK=16777216 cargo"
fi

PKG_SETUP='export PKG_CONFIG_PATH=""; for d in /nix/store/*/lib/pkgconfig /nix/store/*/share/pkgconfig; do [ -d "$d" ] && ls "$d"/*.pc >/dev/null 2>&1 && PKG_CONFIG_PATH="$PKG_CONFIG_PATH:$d"; done; export PKG_CONFIG_PATH'

cd "$REMOTE_DIR" || exit 1

CARGO_TARGET_DIR="$REMOTE_TARGET_NAME" nix --extra-experimental-features 'nix-command flakes' shell $DEPS --command bash -c "$PKG_SETUP && $CARGO_CMD $*"
SCRIPTEOF

      ssh "$REMOTE_HOST" "bash /tmp/remote_cargo_build.sh '$REMOTE_DIR' '$REMOTE_TARGET_NAME' ${REMOTE_ARGS[@]}"
      EXIT_CODE=$?

      if [ $EXIT_CODE -eq 0 ]; then
          echo "=== [Bridge:${SESSION_ID}] Descargando binario compilado de regreso... ==="
          LOCAL_TARGET="$CURRENT_DIR/target"

          # Traer binarios y metadatos (excluye caché incremental que es específica del servidor)
          rsync -avz \
            --exclude 'incremental' \
            --exclude '.fingerprint' \
            --exclude 'build' \
            --exclude 'deps' \
            "$REMOTE_HOST:$REMOTE_TARGET_DIR/" "$LOCAL_TARGET/"

          # NOTA: NO borramos el target remoto — se conserva como caché persistente
          # para que compilaciones subsecuentes sean incrementales.
          # Para limpiarlo manualmente: `just clean-remote-targets`
      fi

      exit $EXIT_CODE
    ) 200>"$LOCK_FILE"
    # =========================================================================
    # LOCK LIBERADO — desde aquí se puede ejecutar la app localmente
    # =========================================================================

    BRIDGE_EXIT=$?

    if [ $BRIDGE_EXIT -ne 0 ]; then
        exit $BRIDGE_EXIT
    fi

    # Si era "run", ejecutamos el binario local directamente
    if [[ "$1" == "run" ]]; then
        BINARY_NAME=""
        if [[ -f "Cargo.toml" ]]; then
            BINARY_NAME=$(grep -m1 '^name = ' Cargo.toml | cut -d'"' -f2)
        fi
        BINARY_NAME="${BINARY_NAME:-syntrix-admin}"
        BINARY_PATH="./target/debug/$BINARY_NAME"

        BIN_ARGS=()
        FOUND_SEPARATOR=false
        for arg in "$@"; do
            if [[ "$FOUND_SEPARATOR" == true ]]; then
                BIN_ARGS+=("$arg")
            elif [[ "$arg" == "--" ]]; then
                FOUND_SEPARATOR=true
            fi
        done

        if [[ -f "$BINARY_PATH" ]]; then
            echo "=== [Bridge:${SESSION_ID}] Iniciando ejecución local directa: $BINARY_PATH ${BIN_ARGS[@]} ==="
            chmod +x "$BINARY_PATH"
            exec "$BINARY_PATH" "${BIN_ARGS[@]}"
        else
            echo "=== [Bridge:${SESSION_ID}] ADVERTENCIA: No se encontró el binario en $BINARY_PATH. Usando cargo local... ==="
            exec "$REAL_CARGO" "$@"
        fi
    fi

    # Si era "tauri dev", ejecutamos Vite + binario localmente
    if [[ "$IS_TAURI_DEV" == "1" ]]; then
        BINARY_NAME=""
        if [[ -f "Cargo.toml" ]]; then
            BINARY_NAME=$(grep -m1 '^name = ' Cargo.toml | cut -d'"' -f2)
        fi
        BINARY_NAME="${BINARY_NAME:-syntrix-admin}"
        BINARY_PATH="./target/debug/$BINARY_NAME"

        if [[ ! -f "$BINARY_PATH" ]]; then
            echo "=== [Bridge:${SESSION_ID}] ADVERTENCIA: No se encontró el binario en $BINARY_PATH. Usando cargo local... ==="
            exec "$REAL_CARGO" "$@"
        fi

        chmod +x "$BINARY_PATH"

        APP_DIR="$(dirname "$CURRENT_DIR")"

        # Detectar el puerto de Vite desde --config antes de matar/iniciar nada
        VITE_PORT=""
        VITE_PORT_FLAG=""
        for arg in "$@"; do
            # Extraer --port N del beforeDevCommand dentro del --config JSON
            if [[ "$arg" =~ beforeDevCommand.*--port[[:space:]]+([0-9]+) ]]; then
                VITE_PORT="${BASH_REMATCH[1]}"
            fi
            # También extraer puerto de devUrl (fallback si no hay --port en beforeDevCommand)
            if [[ -z "$VITE_PORT" && "$arg" =~ devUrl.*http://localhost:([0-9]+) ]]; then
                VITE_PORT="${BASH_REMATCH[1]}"
            fi
        done
        # Fallback: los puertos según tauri.conf.json de cada app
        if [[ -z "$VITE_PORT" ]]; then
            if [[ "$BINARY_NAME" == "syntrix-admin" ]]; then
                VITE_PORT="1421"   # admin/tauri.conf.json → 1421
            else
                VITE_PORT="1420"   # client/tauri.conf.json → 1420
            fi
        fi

        echo "=== [Bridge:${SESSION_ID}] Iniciando beforeDevCommand (pnpm dev) en $APP_DIR (puerto $VITE_PORT)... ==="
        # Matar Vite en el puerto específico (no afecta otras instancias en otros puertos)
        fuser -k "${VITE_PORT}/tcp" 2>/dev/null || true
        sleep 0.5

        # Iniciar Vite en el puerto correcto (--port solo si es diferente del default)
        if [[ "$VITE_PORT" != "1420" && "$VITE_PORT" != "1421" ]]; then
            VITE_PORT_FLAG="--port $VITE_PORT"
        fi
        (cd "$APP_DIR" && pnpm dev $VITE_PORT_FLAG) &
        VITE_PID=$!
        cleanup_vite() { kill "$VITE_PID" 2>/dev/null || true; fuser -k "${VITE_PORT}/tcp" 2>/dev/null || true; }
        trap cleanup_vite EXIT INT TERM

        echo "=== [Bridge:${SESSION_ID}] Esperando a que Vite esté listo en puerto $VITE_PORT... ==="
        for i in $(seq 1 30); do
            if curl -s "http://localhost:${VITE_PORT}" >/dev/null 2>&1; then
                echo "=== [Bridge:${SESSION_ID}] Vite está listo en puerto $VITE_PORT ==="
                break
            fi
            sleep 1
        done

        DEV_URL="http://localhost:${VITE_PORT}"
        echo "=== [Bridge:${SESSION_ID}] Iniciando $BINARY_PATH localmente con --dev-url $DEV_URL ==="
        cd "$CURRENT_DIR"
        TAURI_DEV=true TAURI_DEV_URL="$DEV_URL" "$BINARY_PATH" --dev-url "$DEV_URL"
        BINARY_EXIT=$?
        kill "$VITE_PID" 2>/dev/null || true
        fuser -k "${VITE_PORT}/tcp" 2>/dev/null || true
        exit $BINARY_EXIT
    fi

    exit 0
else
    # Ejecutar localmente cualquier otro comando
    exec "$REAL_CARGO" "$@"
fi
